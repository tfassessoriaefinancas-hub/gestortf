# Local-only copy. The npm scripts listen exclusively on loopback.
LOCAL_AUTH_ENABLED=true
LOCAL_USER_ID=local-owner
LOCAL_USER_EMAIL=admin@example.com
LOCAL_USER_NAME="Administrador"
LOCAL_DATA_DIR=./data

# Optional integrations. The CRM runs without these credentials.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
OPENAI_API_KEY=
OPENAI_COMMAND_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
OPENAI_DOCUMENT_MODEL=
TF_IMPORT_TOKEN=
