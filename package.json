{
  "name": "nexo-crm-nextjs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate-postgres.ts",
    "db:migrate:sqlite": "node scripts/migrate.ts",
    "db:prepare:neon": "node scripts/prepare-neon-migration.ts",
    "db:import:neon": "node scripts/import-neon.ts",
    "db:import": "node scripts/import-snapshot.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts",
    "db:verify:neon": "node scripts/verify-neon.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.43.0",
    "next": "16.2.6",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
